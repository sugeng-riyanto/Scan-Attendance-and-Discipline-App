generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students  Student[]
  classes   Class[]
}

model Class {
  id                String   @id @default(cuid())
  name              String
  level             String
  schoolId          String?
  school            School?  @relation(fields: [schoolId], references: [id])
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  homeroomTeacherId String? @unique
  homeroomTeacher   User?   @relation(fields: [homeroomTeacherId], references: [id])
  students          Student[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([schoolId])
}

model School {
  id         String   @id @default(cuid())
  code       String   @unique // short code e.g. SHB-001
  name       String
  address    String?
  // Per-school branding for the landing/login page and the app header.
  logo       String?  // URL/data-URL of the school logo
  themeColor String?  // hex accent color, e.g. "#10b981"
  headerImage String? // banner photo shown on the school's landing page + directory card
  domain     String?  @unique // dedicated subdomain, e.g. "shb-001.app.test"

  // Public profile shown on the school's landing page (/s/:code) and editable
  // by the school's Admin/Kepala Sekolah (Settings -> Profil).
  description String? // ringkasan profil singkat
  vision      String? // visi sekolah
  mission     String? // misi sekolah (multi-line)
  phone       String? // telepon kontak
  email       String? // email kontak
  hasJhs      Boolean  @default(true) // jenjang JHS (SMP)
  hasShs      Boolean  @default(true) // jenjang SHS (SMA)
  jhsStart    String? // jam masuk JHS, e.g. "07:00"
  jhsEnd      String? // jam pulang JHS, e.g. "14:50"
  shsStart    String? // jam masuk SHS, e.g. "07:00"
  shsEnd      String? // jam pulang SHS, e.g. "15:30"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        User[]
  subscriptions Subscription[]
  classes      Class[]
  students     Student[]

  @@index([isActive])
}

// Yearly subscription (langganan) per school — managed by SUPER_ADMIN.
// status: ACTIVE | INACTIVE | TRIAL | EXPIRED
model Subscription {
  id          String   @id @default(cuid())
  schoolId    String   @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan        String   @default("YEARLY")
  status      String   @default("TRIAL")
  periodStart DateTime?
  periodEnd   DateTime?
  price       Float?   // nominal in IDR per year
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  avatar          String?
  isActive        Boolean  @default(true)
  termsAcceptedAt DateTime?
  email           String?
  // Account security & reminders (per-role Pengaturan Akun)
  pinHash        String?  // hashed PIN for quick unlock (login cepat)
  pinEnabled     Boolean  @default(false)
  authEnabled    Boolean  @default(false) // PIN-based authentication enabled
  reminderEnabled Boolean @default(false)
  reminderType   String?  // CHECK_IN | CHECK_OUT
  reminderLevel  String?  // JHS | SHS (which dismissal schedule the reminder follows)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student        Student?
  parent         Parent?
  teacher        Teacher?
  homeroomOf     Class?
  recordedViolations Violation[]
  recordedGoodDeeds  GoodDeed[]
  dutySchedules        DutySchedule[]
  dutySubstitutes      DutySubstitute[]     @relation("SubstituteTeacher")
  dutyOriginalSchedules DutySubstitute[]    @relation("OriginalTeacher")
  scanActivated        ScanSession[]        @relation("ScanActivator")
  scanDeactivated    ScanSession[]  @relation("ScanDeactivator")
  faceCaptures       FaceReference[]
  auditLogs          AuditLog[]
}

model Student {
  id                   String   @id @default(cuid())
  nisn                 String   @unique
  name                 String
  schoolId             String?
  school               School?  @relation(fields: [schoolId], references: [id])
  classId              String
  class                Class    @relation(fields: [classId], references: [id])
  academicYearId       String
  academicYear         AcademicYear @relation(fields: [academicYearId], references: [id])
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  qrCode               String   @unique
  photoUrl             String?
  gender               String?
  address              String?
  email                String?
  phone                String?
  status               String   @default("AKTIF")
  totalViolationPoints Int      @default(0)
  totalGoodPoints      Int      @default(0)
  faceCaptureEnabled   Boolean  @default(true)
  idCardVisibleToStudent Boolean @default(true)
  idCardVisibleToParent  Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  attendances    Attendance[]
  violations     Violation[]
  goodDeeds      GoodDeed[]
  permissions    Permission[]
  parents        Parent[]
  behaviorAlerts BehaviorAlert[]
  faceReferences FaceReference[]

  @@index([classId])
  @@index([academicYearId])
  @@index([status])
  @@index([name])
  @@index([schoolId])
}

model Parent {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  nip       String?  @unique
  subjects  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  date             DateTime
  checkInTime      DateTime?
  checkOutTime     DateTime?
  status           String
  checkInMethod    String?
  checkOutMethod   String?
  isLateArrival    Boolean   @default(false)
  isEarlyDeparture Boolean   @default(false)
  permissionId     String?   @unique
  permission       Permission? @relation(fields: [permissionId], references: [id])
  verifiedByFace   Boolean   @default(false)
  notes            String?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  geoVerified      Boolean   @default(false)
  deviceInfo       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([status])
  @@index([studentId])
}

model Permission {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  type           String
  reason         String
  requestedBy    String
  approvedBy     String?
  status         String    @default("PENDING")
  date           DateTime
  startTime      DateTime?
  endTime        DateTime?
  attachmentData String?   @db.Text
  attachmentType String?
  attachmentName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendance  Attendance?

  @@index([studentId])
  @@index([status])
  @@index([date])
}

model ViolationCategory {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  level         String
  defaultPoints Int
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  violations    Violation[]
}

model Violation {
  id               String            @id @default(cuid())
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id])
  categoryId       String
  category         ViolationCategory @relation(fields: [categoryId], references: [id])
  points           Int
  description      String?
  date             DateTime
  recordedBy       String
  recorder         User              @relation(fields: [recordedBy], references: [id])
  scanMethod       String?           @default("MANUAL")
  teacherSignature String?
  studentSignature String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId])
  @@index([date])
  @@index([categoryId])
}

model GoodDeedCategory {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  defaultPoints Int
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goodDeeds     GoodDeed[]
}

model GoodDeed {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id])
  categoryId       String
  category         GoodDeedCategory @relation(fields: [categoryId], references: [id])
  points           Int
  description      String?
  date             DateTime
  recordedBy       String
  recorder         User            @relation(fields: [recordedBy], references: [id])
  scanMethod       String?         @default("MANUAL")
  teacherSignature String?
  studentSignature String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([studentId])
  @@index([date])
}

model BehaviorAlert {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  alertType    String
  message      String
  threshold    Int
  isRead       Boolean  @default(false)
  targetRole   String
  targetUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([targetRole])
  @@index([isRead])
}

model DutySchedule {
  id          String          @id @default(cuid())
  dayOfWeek   Int             // ISO: 1=Monday..7=Sunday
  startTime   String          // "HH:mm" 24h format
  endTime     String          // "HH:mm" 24h format
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  location    String
  tasks       Json            @default("[]")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  substitutes DutySubstitute[]

  @@index([dayOfWeek, isActive])
  @@index([teacherId])
}

model DutySubstitute {
  id                  String   @id @default(cuid())
  dutyScheduleId      String
  dutySchedule        DutySchedule @relation(fields: [dutyScheduleId], references: [id], onDelete: Cascade)
  substituteTeacherId String
  substituteTeacher   User     @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  originalTeacherId   String
  originalTeacher     User     @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteDate      DateTime @db.Date
  reason              String?
  createdAt           DateTime @default(now())

  @@unique([dutyScheduleId, substituteDate])
  @@index([substituteDate])
}

model SchoolDocument {
  id          String   @id @default(cuid())
  type        String   // HANDBOOK, CALENDAR, INFORMATION
  title       String
  description String?
  url         String
  isPublished Boolean  @default(false)
  createdBy   String
  period      String?  // WEEKLY, MONTHLY (only for INFORMATION)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
}

model SchoolConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GeofenceConfig {
  id          String   @id @default(cuid())
  name        String   // e.g. "Gerbang Utama", "Area Sekolah"
  centerLat   Float    // latitude of geofence center
  centerLng   Float    // longitude of geofence center
  radiusMeters Float   // radius in meters (e.g. 100)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // default geofence for check-in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScanSession {
  id          String   @id @default(cuid())
  isActive    Boolean  @default(false)
  defaultMode String   @default("FACE")
  activatedBy String?
  activator   User?    @relation("ScanActivator", fields: [activatedBy], references: [id])
  activatedAt DateTime?
  deactivatedBy String?
  deactivator User?    @relation("ScanDeactivator", fields: [deactivatedBy], references: [id])
  deactivatedAt DateTime?
  shift       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model FaceReference {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  photoBase64 String   // base64 encoded face photo
  faceDescriptor String? // JSON array of 128 floats - face embedding vector for recognition
  captureIndex Int     // which capture number (1-5 recommended)
  capturedBy  String?  // userId who captured
  capturer    User?     @relation(fields: [capturedBy], references: [id])
  captureMethod String? // MANUAL, WEBCAM
  quality     Float?   // quality score if available
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Immutable trail of sensitive events (login/logout, exports, imports,
// config changes, account changes, breach reports) so Admin & Kepala Sekolah
// can monitor users and detect unusual activity per UU PDP / T&C declarations.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  username  String?
  role      String?
  action    String   // e.g. LOGIN_SUCCESS, EXPORT, IMPORT, RESEED, PASSWORD_CHANGE, BREACH_REPORTED
  category  String   // AUTH, DATA, EXPORT, IMPORT, SETTINGS, ACCOUNT, BREACH, SYSTEM
  level     String?  // JHS | SHS | null (jenjang the event relates to)
  severity  String   @default("INFO") // INFO | WARNING | CRITICAL
  schoolId  String?  // school the event relates to (e.g. subscription renewals)
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([category])
  @@index([severity])
  @@index([level])
  @@index([schoolId])
  @@index([createdAt])
  @@index([userId])
}

model OfflineQueue {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // attendance, violation, etc.
  payload     String   // JSON string of the data
  status      String   @default("PENDING") // PENDING, SYNCED, FAILED
  attempts    Int      @default(0)
  lastAttempt DateTime?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
