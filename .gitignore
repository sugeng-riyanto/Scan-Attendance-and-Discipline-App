# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# generated prisma client
/src/generated/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/.freebuff/

# dev-up.sh records the app-port listener pid and what it started here, and
# dev-down.sh reads them back (see .zscripts/lib-stack.sh)
.zscripts/dev-up.pid
.zscripts/dev-up.state.json
# what each service writes about itself at boot (pid, port, checkout), which dev-up
# reads instead of asking the OS which pid owns its port: the dev server, and the
# socket mini-service
.zscripts/dev-server.json
.zscripts/attendance-socket.json
