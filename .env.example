# Database (PostgreSQL) - Required
DATABASE_URL="postgresql://user:password@host:5432/database_name"

# JWT Secret - Required (generate a strong random string)
JWT_SECRET="your-super-secret-random-string-min-32-chars"

# App URL - Required for production
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Socket Service (optional, for real-time updates)
# If not set, the app works without live dashboard updates
NEXT_PUBLIC_SOCKET_URL="https://your-socket-service.onrender.com"
SOCKET_SERVER_URL="https://your-socket-service.onrender.com"

# School Domains (optional, for subdomain routing)
# Format: hostname=CODE,hostname2=CODE2
# SCHOOL_DOMAINS="shb-001.yourdomain.com=SHB-001"
